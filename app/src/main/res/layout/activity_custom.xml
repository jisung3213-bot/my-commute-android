<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="나만의 출퇴근" android:textColor="@color/text_primary"
                android:textSize="26sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="10dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDirectionOut"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="출근길"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDirectionBack"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="퇴근길"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
            <TextView android:id="@+id/textActiveRoutine" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="6dp"
                android:textColor="@color/text_secondary" android:text=""/>
            <TextView style="@style/Text.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="저장된 경로"/>
            <LinearLayout android:id="@+id/savedRoutineList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnNewRoutine"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="+ 새 경로 작성"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnMakeDefault"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="현재 경로를 기본 경로로 지정"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <TextView style="@style/Text.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:text="경로 이름"/>
            <EditText android:id="@+id/editRouteName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:singleLine="true"
                android:hint="예: 월수금 학교 가는 길" android:maxLength="50"/>

            <TextView style="@style/Text.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="1. 이동 장소"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnStartPlace"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="출발지 검색" android:textAlignment="viewStart"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEndPlace"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="도착지 검색" android:textAlignment="viewStart"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <TextView android:id="@+id/textWaypoints" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                android:padding="8dp" android:text="주변 시설·경유지 없음"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAddWaypoint"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="주변 시설·경유지 장소 검색"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnClearWaypoints"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="추가한 장소 지우기"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="경유지 최대 2개 · 순서대로 경로에 반영"
                android:textColor="@color/text_secondary" android:textSize="12sp"/>

            <TextView style="@style/Text.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="22dp"
                android:text="2. 목표 시간과 반복"/>
            <TextView style="@style/Text.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="목표 도착 시각 (HH:mm)"/>
            <EditText android:id="@+id/editDeparture" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="09:00"
                android:inputType="time" android:singleLine="true"/>
            <TextView style="@style/Text.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="도착 여유시간 (분)"/>
            <EditText android:id="@+id/editMargin" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="number" android:text="10"/>
            <TextView style="@style/Text.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="목표 도착일의 요일"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <CheckBox android:id="@+id/dayMon" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:text="월"
                    android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/dayTue" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:text="화"
                    android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/dayWed" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:text="수"
                    android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <CheckBox android:id="@+id/dayThu" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:text="목"
                    android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/dayFri" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:text="금"
                    android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/daySat" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:text="토"
                    android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/daySun" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:text="일"
                    android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"/>
            </LinearLayout>

            <TextView style="@style/Text.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:text="3. 추천 조건"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchWeather" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="기상정보 반영"
                android:padding="10dp"/>
            <TextView android:id="@+id/textWeatherStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="8dp"
                android:text="" android:visibility="gone"
                android:textColor="@color/text_secondary"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnSearchTransit"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="경로 검색"/>
            <TextView android:id="@+id/textTransitResult" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                android:padding="8dp" android:text="" android:visibility="gone"/>
            <LinearLayout android:id="@+id/transitCards" android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPreviewMap"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="선택 경로 지도에서 보기" android:enabled="false"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveRoutine"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="경로 설정 저장" android:enabled="true"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:visibility="gone"
                android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="10dp"/>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
