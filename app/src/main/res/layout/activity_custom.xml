<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="출퇴근 루틴 설정"
                android:textSize="26sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="좌표는 지도 표시와 보행 경로 API를 사용할 때 필요해요. 시간은 24시간제 HH:mm 형식이에요."
                android:textColor="@color/text_secondary" android:textSize="13sp"/>
            <TextView style="@style/Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:text="기본 경로"/>
            <EditText android:id="@+id/editRoutineName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="루틴 이름" android:singleLine="true"/>
            <EditText android:id="@+id/editStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="출발 장소 이름" android:singleLine="true"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <EditText android:id="@+id/editStartLat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="출발 위도" android:inputType="numberDecimal|numberSigned"/>
                <EditText android:id="@+id/editStartLon" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="출발 경도" android:inputType="numberDecimal|numberSigned"/>
            </LinearLayout>
            <EditText android:id="@+id/editEnd" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="도착 장소 이름" android:singleLine="true"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <EditText android:id="@+id/editEndLat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="도착 위도" android:inputType="numberDecimal|numberSigned"/>
                <EditText android:id="@+id/editEndLon" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="도착 경도" android:inputType="numberDecimal|numberSigned"/>
            </LinearLayout>
            <TextView style="@style/Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="시간·이동수단"/>
            <EditText android:id="@+id/editDeparture" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="목표 도착 시각 HH:mm" android:inputType="time"/>
            <EditText android:id="@+id/editMargin" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="도착 여유시간 (분)" android:inputType="number"/>
            <EditText android:id="@+id/editDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="일반 계획 이동시간 (분)" android:inputType="number"/>

            <EditText android:id="@+id/editNormalWalk" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="일반 계획 도보시간 (분)" android:inputType="number"/>

            <EditText android:id="@+id/editAlertLead" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="사전 출발 알림 (분 전)" android:inputType="number"/>
            <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="일반 이동수단"/>
            <Spinner android:id="@+id/spinnerMode" android:layout_width="match_parent" android:layout_height="48dp"/>


            <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="목표 도착일의 요일 (자정 이후 도착 포함)"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <CheckBox android:id="@+id/dayMon" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="월"/>
                <CheckBox android:id="@+id/dayTue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="화"/>
                <CheckBox android:id="@+id/dayWed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="수"/>
                <CheckBox android:id="@+id/dayThu" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="목"/>
                <CheckBox android:id="@+id/dayFri" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="금"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <CheckBox android:id="@+id/daySat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="토"/>
                <CheckBox android:id="@+id/daySun" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="일"/>
            </LinearLayout>
            <TextView style="@style/Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="첫 대중교통 / 실시간 연동 정보"/>
            <EditText android:id="@+id/editBoardingStopId" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="정류장 ID / 지하철역 코드"/>
            <EditText android:id="@+id/editBoardingRoute" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="버스 번호 또는 노선"/>
            <EditText android:id="@+id/editBoardingDirection" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="탑승 방향 또는 행선지"/>
            <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="API를 연결하기 전에는 실시간 도착정보를 조회하지 않아요."/>
            <TextView style="@style/Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="경유지 (식사·커피 기능은 추후 추가)"/>
            <TextView android:id="@+id/textWaypoints" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:padding="12dp" android:background="@drawable/bg_card"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAddWaypoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="경유지 추가"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnClearWaypoints" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="경유지 전체 삭제"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <CheckBox android:id="@+id/checkDemoRain" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="테스트용 우천 시나리오 적용 (실제 기상 데이터 아님)"/>
            <CheckBox android:id="@+id/checkDemoCold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="테스트용 한파특보 적용 (실제 특보 아님)"/>
            <CheckBox android:id="@+id/checkShowMap" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:checked="true" android:text="지도 화면에 경로 표시"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveRoutine" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="루틴 저장 및 알림 예약"/>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
