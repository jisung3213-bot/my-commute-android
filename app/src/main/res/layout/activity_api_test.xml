<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="서울 모빌리티 API 연결 테스트" android:textSize="21sp"
            android:textStyle="bold" android:paddingBottom="12dp" />
        <Button android:id="@+id/openTmap" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TMAP 장소·경로 API 테스트 열기" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="① 서울시 따릉이 실시간 대여정보" android:textStyle="bold" android:textSize="17sp"/>
        <EditText android:id="@+id/bikeKey" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="서울 열린데이터광장 API 키 (없으면 sample)" android:singleLine="true" android:inputType="textVisiblePassword"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/bikeSample" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="샘플 5건" />
            <Button android:id="@+id/bikeLive" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="실제 조회 20건" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="② 국토교통부 TAGO 공유 PM API" android:textStyle="bold" android:textSize="17sp" android:paddingTop="18dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="공공데이터포털 활용신청 후 API 상세명세의 완성된 요청 URL을 입력하세요. URL의 키 부분은 {KEY}로 치환할 수 있습니다. 미확인 엔드포인트를 임의로 고정하지 않았습니다." android:textSize="12sp" />
        <EditText android:id="@+id/pmUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="https://.../공식요청경로?serviceKey={KEY}&amp;..."
            android:inputType="textUri" android:minLines="2" android:maxLines="4"/>
        <EditText android:id="@+id/pmKey" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="TAGO API 키 (URL에 {KEY} 사용 시)" android:inputType="textVisiblePassword" />
        <Button android:id="@+id/pmRequest" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TAGO GET 요청" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="③ 요청·응답 결과" android:textStyle="bold" android:textSize="17sp" android:paddingTop="18dp" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="대기 중" android:padding="10dp" />
        <Button android:id="@+id/copyResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="결과 복사 (키 마스킹)" />
        <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#F1F1F1" android:textIsSelectable="true" android:padding="12dp"
            android:text="버튼을 누르면 HTTP 상태코드, 파싱 결과와 원본 응답 일부가 여기에 표시됩니다." android:typeface="monospace" android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
