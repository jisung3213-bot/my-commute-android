<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="실시간 이동" android:textColor="@color/text_primary"
                android:textStyle="bold" android:textSize="26sp"/>
            <TextView android:id="@+id/liveRouteTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="" android:textColor="@color/text_secondary"/>
            <TextView android:id="@+id/liveOriginNotice" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite" android:textStyle="bold"
                android:visibility="gone"/>
            <TextView android:id="@+id/liveSyncStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="" android:visibility="gone" android:textColor="@color/text_secondary" android:textSize="12sp"/>

            <ProgressBar android:id="@+id/liveLoading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="2dp"
                android:layout_marginTop="5dp" android:indeterminate="true"
                android:visibility="gone"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:padding="14dp"
                android:background="@drawable/bg_card" android:orientation="vertical">
                <TextView style="@style/Text.Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="지금의 출발 판단"/>
                <TextView android:id="@+id/liveDepartureHeadline" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="이동 정보 확인 중" android:textSize="23sp"
                    android:textStyle="bold" android:textColor="@color/primary_dark"/>
                <TextView android:id="@+id/liveDepartureDetail" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary" android:text="이동 정보 확인 중"/>
                <TextView android:id="@+id/liveArrivalPlan" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
            <TextView android:id="@+id/livePosition" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="위치 추적 꺼짐"
                android:textColor="@color/text_secondary" android:textSize="13sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/liveStartTracking"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="위치 추적 시작"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/liveStopTracking"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="이번 이동 추적 종료" android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="8dp" android:padding="12dp"
                android:background="@drawable/bg_card">
                <TextView style="@style/Text.Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="이동 시간대 날씨"/>
                <TextView android:id="@+id/liveWeather" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="기온 확인 중" android:textSize="23sp" android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/liveWeatherDetails" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="강수 정보 확인 중" android:textSize="15sp"
                    android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/liveWeatherTime" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="예보 시각 확인 중" android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="8dp" android:padding="12dp"
                android:background="@drawable/bg_card">
                <TextView style="@style/Text.Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="이동 특이사항"/>
                <TextView android:id="@+id/liveAlerts" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="주의사항 없음" android:textSize="14sp"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <TextView style="@style/Text.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="오늘의 이동 경로"/>
            <com.example.mycommute.ui.RouteSchematicView
                android:id="@+id/liveSchematic" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="120dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"/>
            <TextView android:id="@+id/liveCurrentStage" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="8dp"
                android:text="" android:visibility="gone"
                android:textColor="@color/text_primary"/>
            <TextView android:id="@+id/liveRouteSteps" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="10dp"
                android:text="경로 요약"
                android:textColor="@color/text_secondary"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/liveOpenMap" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="전체 지도 보기"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            <TextView style="@style/Text.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:text="다음 대중교통"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="18dp" android:background="@drawable/bg_card"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/liveVehicleMode"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="교통" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/primary_dark" android:background="@drawable/bg_route_selected"
                        android:paddingStart="10dp" android:paddingEnd="10dp"
                        android:paddingTop="7dp" android:paddingBottom="7dp"/>
                    <TextView android:id="@+id/liveNextVehicle"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginStart="10dp"
                        android:text="도착정보 확인 중" android:textColor="@color/text_primary"
                        android:textStyle="bold" android:textSize="17sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/liveVehicleEtaRow"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="15dp" android:orientation="horizontal"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="현재 차량" android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/liveVehicleEta"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="조회 중" android:textSize="22sp" android:textStyle="bold"
                            android:textColor="@color/primary_dark" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/liveVehicleNextColumn"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="다음 차량" android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/liveVehicleNext"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="정보 없음" android:textSize="18sp" android:textStyle="bold"
                            android:textColor="@color/text_primary" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </LinearLayout>
                <View android:id="@+id/liveVehicleEtaDivider"
                    android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="14dp" android:background="@color/border"
                    android:visibility="gone"/>
                <TextView android:id="@+id/liveBoarding"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="승차 가능성 확인 중"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/text_secondary"/>
                <LinearLayout android:id="@+id/liveVehicleAuxRow"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView android:id="@+id/liveVehicleWalk"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="승차지 이동시간 —"
                        android:textSize="13sp" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/liveVehicleSlack"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:gravity="end"
                        android:text="여유시간 —" android:textSize="13sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <TextView android:id="@+id/liveArrivalDiagnostic"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="7dp" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:visibility="gone"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/liveRefresh"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="현재 정보 확인"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
