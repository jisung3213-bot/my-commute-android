<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="4dp" android:paddingBottom="6dp"
    android:background="@color/surface" android:orientation="horizontal">
    <Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
        android:minWidth="0dp" android:minHeight="48dp"
        android:paddingStart="0dp" android:paddingEnd="0dp" android:gravity="center"
        android:singleLine="true" android:textAllCaps="false"
        android:backgroundTint="@color/surface" android:textColor="@color/primary_dark" android:textSize="12sp" android:text="홈" />
    <Button android:id="@+id/navCustom" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
        android:minWidth="0dp" android:minHeight="48dp"
        android:paddingStart="0dp" android:paddingEnd="0dp" android:gravity="center"
        android:singleLine="true" android:textAllCaps="false"
        android:backgroundTint="@color/surface" android:textColor="@color/primary_dark" android:textSize="12sp" android:text="루틴" />
    <Button android:id="@+id/navMap" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
        android:minWidth="0dp" android:minHeight="48dp"
        android:paddingStart="0dp" android:paddingEnd="0dp" android:gravity="center"
        android:singleLine="true" android:textAllCaps="false"
        android:backgroundTint="@color/surface" android:textColor="@color/primary_dark" android:textSize="12sp" android:text="지도" />
    <Button android:id="@+id/navTracking" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
        android:minWidth="0dp" android:minHeight="48dp"
        android:paddingStart="0dp" android:paddingEnd="0dp" android:gravity="center"
        android:singleLine="true" android:textAllCaps="false"
        android:backgroundTint="@color/surface" android:textColor="@color/primary_dark" android:textSize="12sp" android:text="이동" />
    <Button android:id="@+id/navSettings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
        android:minWidth="0dp" android:minHeight="48dp"
        android:paddingStart="0dp" android:paddingEnd="0dp" android:gravity="center"
        android:singleLine="true" android:textAllCaps="false"
        android:backgroundTint="@color/surface" android:textColor="@color/primary_dark" android:textSize="12sp" android:text="설정" />
</LinearLayout>
