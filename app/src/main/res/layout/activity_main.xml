<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="오늘의 출퇴근"
                android:textSize="26sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/homeOutbound"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="출근길"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/homeReturn"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="퇴근길" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:padding="14dp" android:background="@drawable/bg_card" android:orientation="vertical">
                <TextView style="@style/Text.Label" android:id="@+id/mainDirection" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/mainRoute" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/mainTime" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:textSize="14sp" android:textColor="@color/text_secondary"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnGoTracking" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="실시간 이동"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnGoLogs"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp" android:text="알림 로그"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSelectRoutine"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="다른 경로"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
