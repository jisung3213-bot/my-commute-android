<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="설정" android:textSize="26sp" android:textStyle="bold"
                android:textColor="@color/text_primary"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:padding="16dp"
                android:background="@drawable/bg_card" android:orientation="vertical">
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAllAlerts"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="전체 알림" android:textSize="17sp"
                    android:textColor="@color/text_primary"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="알림 종류"
                    android:textStyle="bold" android:textColor="@color/text_primary"/>
                <LinearLayout android:id="@+id/alertSwitchList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:padding="16dp"
                android:background="@drawable/bg_card" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="알림 기준" android:textStyle="bold" android:textSize="17sp"
                    android:textColor="@color/text_primary"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="출발 준비 · 몇 분 전"
                    android:textColor="@color/text_secondary"/>
                <EditText android:id="@+id/settingPrepareMinutes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:singleLine="true" android:maxLength="3"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="차량 도착 임박 · 몇 분 전"
                    android:textColor="@color/text_secondary"/>
                <EditText android:id="@+id/settingVehicleMinutes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:singleLine="true" android:maxLength="2"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="승차지 출발 · 남은 여유(분)"
                    android:textColor="@color/text_secondary"/>
                <EditText android:id="@+id/settingWalkSlackMinutes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:singleLine="true" android:maxLength="2"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="도착 지연 · 몇 분 이상"
                    android:textColor="@color/text_secondary"/>
                <EditText android:id="@+id/settingDelayMinutes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:singleLine="true" android:maxLength="2"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveAlarmSettings"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="기준 저장"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:padding="16dp"
                android:background="@drawable/bg_card" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="기본 설정" android:textStyle="bold" android:textSize="17sp"
                    android:textColor="@color/text_primary"/>
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:text="새 루틴 기본 도착 여유시간(분)"
                    android:textColor="@color/text_secondary"/>
                <EditText android:id="@+id/settingDefaultMargin"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:singleLine="true" android:maxLength="3"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDefaultWeather"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="새 루틴 날씨 반영"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveDefaultSettings"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="기본값 저장"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettingsRoutine"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="루틴·기본 경로 관리"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettingsLogs"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="알림 기록"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettingsSystemNotifications"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="알림 소리·진동·권한"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettingsLocation"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="위치 권한"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettingsExactAlarms"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="정시 알림 권한" android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettingsLogout"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="로그아웃"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
                <TextView android:id="@+id/settingsPermissionNotice"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:visibility="gone" android:textColor="@color/warning"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
