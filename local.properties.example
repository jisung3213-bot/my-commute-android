# Android Studio creates sdk.dir. Keep local.properties out of Git.
# Server URL must be HTTPS and omit the trailing slash.
API_BASE_URL=https://YOUR_SERVER_URL

# Optional: Android map SDK only. This is an extractable client key, NOT a secret.
# Restrict it to the package/signing certificate/provider-side controls when supported.
TMAP_MAP_SDK_KEY=YOUR_MAP_SDK_KEY
# NEVER include KMA/TAGO/Seoul subway/transit/POI/pedestrian keys in the APK.
